pipeline {
    agent {
        label 'windows'
    }

    parameters {
        string(
            name: 'SCRIPT_PATH',
            defaultValue: 'Scripts\\MyScript.ps1',
            description: 'Path to the PowerShell script within the repository'
        )
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Record Existing Files') {
            steps {
                powershell '''
                    Get-ChildItem -Recurse -File |
                        Where-Object {
                            $_.Extension -in '.txt','.csv','.xlsx'
                        } |
                        Select-Object FullName, LastWriteTimeUtc |
                        Export-Csv before.csv -NoTypeInformation
                '''
            }
        }

        stage('Run Script') {
            steps {
                powershell """
                    Write-Host "Running script: ${params.SCRIPT_PATH}"

                    if (!(Test-Path "${params.SCRIPT_PATH}")) {
                        throw "Script not found: ${params.SCRIPT_PATH}"
                    }

                    & "${params.SCRIPT_PATH}"
                """
            }
        }

        stage('Find New Or Modified Files') {
            steps {
                powershell '''
                    $before = Import-Csv before.csv

                    New-Item -ItemType Directory -Force -Path Artifacts | Out-Null

                    $after = Get-ChildItem -Recurse -File |
                        Where-Object {
                            $_.Extension -in '.txt','.csv','.xlsx' -and
                            $_.Name -ne 'before.csv' -and
                            $_.FullName -notmatch '\\Artifacts\\'
                        }

                    foreach ($file in $after) {

                        $existing = $before | Where-Object {
                            $_.FullName -eq $file.FullName
                        }

                        $copyFile = $false

                        if (-not $existing) {
                            $copyFile = $true
                        }
                        elseif ($file.LastWriteTimeUtc -gt ([datetime]$existing.LastWriteTimeUtc)) {
                            $copyFile = $true
                        }

                        if ($copyFile) {

                            $relativePath = $file.FullName.Substring($PWD.Path.Length + 1)
                            $destination = Join-Path "Artifacts" $relativePath

                            New-Item `
                                -ItemType Directory `
                                -Force `
                                -Path (Split-Path $destination) | Out-Null

                            Copy-Item $file.FullName $destination -Force
                        }
                    }
                '''
            }
        }
    }

    post {
        always {
            archiveArtifacts(
                artifacts: 'Artifacts/**',
                allowEmptyArchive: true
            )
        }
    }
}